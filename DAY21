# 2. Find largest number using *args
def find_largest(*args):
    if not args:
        return None

    largest = args[0]

    for num in args:
        if num > largest:
            largest = num

    return largest


result = find_largest(10, 25, 7, 42, 18, 30)

print("Numbers: 10, 25, 7, 42, 18, 30")
print("Largest number:", result)


