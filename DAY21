# 3. Student information using **kwargs
def student_info(**kwargs):
    print("Student Information:")

    for key, value in kwargs.items():
        print(key.capitalize() + ":", value)


student_info(
    name="Anjali Sharma",
    age=20,
    course="CSE (AI & ML)",
    semester=4,
    college="UIET Kurukshetra"
)


